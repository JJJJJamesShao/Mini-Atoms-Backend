# 服务器
PORT=3000
NODE_ENV=development

# 数据库（PostgreSQL）
DB_HOST=your-ecs-ip
DB_PORT=5432
DB_NAME=mini_atoms
DB_USER=your-user
DB_PASSWORD=your-password

# 阿里云 OSS
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=your-bucket
ALIYUN_OSS_ACCESS_KEY_ID=your-ak
ALIYUN_OSS_ACCESS_KEY_SECRET=your-sk
ALIYUN_OSS_ENDPOINT=your-endpoint

# JWT / 认证（至少 16 位随机串）
JWT_SECRET=your-secret

# LLM Provider（真实 LLM 链路必填；MOCK_LLM=1 冒烟可留空）
# 百炼代理：clarify/spec/locate 快模型 + generate 兜底
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
# GLM：generate 主路径
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名覆盖（可选，缺省用代码内置值）
# GLM_5_2=glm-5.2
# QWEN_3_6_FLASH=qwen3.6-flash

# 冒烟验证：=1 时 pipeline 用罐头执行器，不调真实 LLM
# MOCK_LLM=1

# 第二层 LLM 语义内容过滤（按 token 计费，默认关闭；关键词层通过后才触发）
# LLM_FILTER_ENABLED=true
# LLM_FILTER_THRESHOLD=0.7   # 置信度超过该值才拦截
