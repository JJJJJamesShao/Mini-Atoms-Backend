#!/bin/bash
# pre-push hook: 逐引用检查推送目标
# - 禁止推送（创建/更新）远程 main 分支
# - 禁止推送（创建/更新）非 feat/ 开头的远程分支
# - 删除远程分支（local_sha 为空）始终放行，与当前所在分支无关

zero_sha=0000000000000000000000000000000000000000
blocked=0

while read local_ref local_sha remote_ref remote_sha
do
    # 删除远程分支：放行
    if [ "$local_sha" = "$zero_sha" ]; then
        continue
    fi

    # 规则 1: 禁止直接推送 (push) 到远程 main 分支
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo ""
        echo "❌ ERROR: 禁止直接推送 (push) 到远程 main 分支。"
        echo ""
        echo "   正确工作流："
        echo "   1. 确保你在 feat/* 分支上: git checkout feat/your-branch"
        echo "   2. 推送到远程同名分支: git push origin feat/your-branch"
        echo "   3. 在 GitHub 网页上创建 Pull Request"
        echo "   4. 由仓库管理员手动 Review 并合并到 main"
        echo ""
        blocked=1
        continue
    fi

    # 规则 2: 推送的远程分支名必须以 feat/ 开头
    if [[ ! "$remote_ref" =~ ^refs/heads/feat/ ]]; then
        echo ""
        echo "❌ ERROR: 推送目标 '$remote_ref' 不符合命名规范。"
        echo ""
        echo "   所有开发分支必须以 'feat/' 开头，例如："
        echo "   • feat/pipeline-api"
        echo "   • feat/auth-module"
        echo "   • feat/fix-login-bug"
        echo ""
        echo "   请执行：git checkout -b feat/你的分支名"
        echo ""
        blocked=1
        continue
    fi
done

if [ "$blocked" = "1" ]; then
    exit 1
fi

local_branch=$(git rev-parse --abbrev-ref HEAD)
echo "✅ 分支检查通过: $local_branch"
exit 0
